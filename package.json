{
  "name": "hooshyar-pos",
  "version": "2.0.0",
  "private": true,
  "description": "هوشیار POS - نسخه‌های مستقل ویندوز و اندروید با کارکرد آفلاین و همگام‌سازی اختیاری",
  "author": "Hooshyar POS Team",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node tools/check.js",
    "test": "node tools/check.js",
    "desktop": "electron electron/main.cjs",
    "desktop:win": "electron-builder --win nsis --publish never"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ir.hooshyar.pos",
    "productName": "Hooshyar POS",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "webapp/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "npmRebuild": false
  }
}
