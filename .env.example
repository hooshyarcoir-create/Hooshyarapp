# Node.js host: copy these values into the host's environment-variable panel.
PORT=3000
HOST=0.0.0.0

# Shared sync API token: use a cryptographically random value of at least 32 chars.
SYNC_API_TOKEN=replace-with-64-random-hex-characters

# Choose mysql (MySQL/MariaDB) or sqlsrv (SQL Server 2014+).
SYNC_DB_DRIVER=mysql
SYNC_DB_HOST=127.0.0.1
SYNC_DB_PORT=3306
SYNC_DB_NAME=hooshyar_pos
SYNC_DB_USER=hooshyar
SYNC_DB_PASSWORD=replace-with-a-long-random-password

# SQL Server only (use port 1433; production should normally use encryption).
SYNC_DB_ENCRYPT=true
SYNC_DB_TRUST_SERVER_CERTIFICATE=false
SYNC_DB_POOL_SIZE=10
