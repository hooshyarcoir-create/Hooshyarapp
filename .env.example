# Copy to .env and set unique random values. Never commit .env.
HOOSHYAR_DB_NAME=hooshyar_pos
HOOSHYAR_DB_USER=hooshyar
HOOSHYAR_DB_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
HOOSHYAR_API_TOKEN=replace-with-at-least-64-random-hex-characters
HOOSHYAR_API_PORT=8080
